+  gap: 48px;
+  align-items: center;
+  background: var(--ink);
+  color: var(--bone);
+  border-top: 1px solid var(--line-dark);
+}
+
+.masterclass-tile {
+  position: relative;
+  display: grid;
+  place-items: center;
+  aspect-ratio: 16 / 9;
+  border: 1px solid var(--gold);
+  background:
+    linear-gradient(135deg, rgba(199, 162, 89, 0.16), transparent 55%),
+    var(--ink-soft);
+}
+
+.masterclass-play {
+  display: grid;
+  place-items: center;
+  width: 84px;
+  height: 84px;
+  border: 1px solid var(--gold);
+  border-radius: 50%;
+  color: var(--gold);
+  font-size: 26px;
+  padding-left: 6px;
+}
+
+.masterclass-label {
+  position: absolute;
+  left: 20px;
+  bottom: 18px;
+  font-family: "Barlow Condensed CG", sans-serif;
+  font-size: 12px;
+  letter-spacing: 2px;
+  text-transform: uppercase;
+  color: rgba(242, 239, 231, 0.6);
+}
+
+.masterclass-copy .eyebrow { color: var(--gold); }
+
+.masterclass-copy h2 { margin: 22px 0 0; }
+
+.masterclass-copy > p {
+  max-width: 480px;
+  margin: 22px 0 30px;
+  color: rgba(242, 239, 231, 0.66);
+  font-size: 16px;
+  line-height: 1.65;
+}
+
+/* ---- Responsive ---- */
+@media (max-width: 1080px) {
+  .stat-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .stat:nth-child(2) { border-right: 0; }
+  .standard-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .ladder-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .ladder-row li { border-bottom: 1px solid var(--line-dark); }
+  .ladder-row li:nth-child(2n) { border-right: 0; }
+  .builder-presets-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .builder-layout { grid-template-columns: 1fr; }
+  .builder-summary { position: static; }
+  .month-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .masterclass { grid-template-columns: 1fr; }
+}
+
+@media (max-width: 720px) {
+  .stat-row { grid-template-columns: 1fr; }
+  .stat { border-right: 0; border-bottom: 1px solid var(--line-dark); }
+  .stat:last-child { border-bottom: 0; }
+  .standard-grid { grid-template-columns: 1fr; }
+  .ladder-row { grid-template-columns: 1fr; }
+  .ladder-row li { border-right: 0; }
+  .week-grid { grid-template-columns: 1fr; }
+  .challenge-body { grid-template-columns: 1fr; }
+  .challenge-plan { grid-template-columns: 1fr; }
+  .two-paths-grid { grid-template-columns: 1fr; }
+  .builder-presets-row { grid-template-columns: 1fr; }
+  .builder-item { grid-template-columns: 26px minmax(0, 1fr); }
+  .builder-item-price { grid-column: 2; justify-items: start; }
+  .month-grid { grid-template-columns: 1fr 1fr; }
+  .challenge-signup { padding: 26px 20px; }
+}
+
+@media (max-width: 480px) {
+  .month-grid { grid-template-columns: 1fr; }
+}
